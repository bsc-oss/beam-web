.mx_SetPhonebookConsent {
    margin-top: var(--cpd-space-8x);

    .mx_SetPhonebookConsent_heading_manager {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        column-gap: var(--cpd-space-1x);
    }

    .mx_SetPhonebookConsent_options {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-3x);
        margin-top: var(--cpd-space-4x);
    }

    .mx_SetPhonebookConsent_option {
        --option-padding: var(--cpd-space-4x);
        --option-gap: var(--cpd-space-3x);
        --option-field-width: 20px;

        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: var(--cpd-space-2x);
        overflow: hidden;
    }

    .mx_SetPhonebookConsent_option_summary {
        display: flex;
        align-items: flex-start;
        gap: var(--option-gap);
        padding: var(--option-padding);
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }
    }

    .mx_SetPhonebookConsent_option_field {
        width: var(--option-field-width);
        flex-shrink: 0;
    }

    .mx_SetPhonebookConsent_option_chevron {
        width: 20px;
        height: 20px;
        margin-left: auto;
        flex-shrink: 0;
        transition: transform 0.2s ease;
        transform: rotate(-90deg);
        color: var(--cpd-color-icon-secondary);
    }

    .mx_SetPhonebookConsent_option[open] .mx_SetPhonebookConsent_option_chevron {
        transform: rotate(0deg);
    }

    .mx_SetPhonebookConsent_option_header {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);
        flex: 1;
    }

    .mx_SetPhonebookConsent_option_title {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: var(--cpd-font-size-body-md);
        color: var(--cpd-color-text-primary);
    }

    .mx_SetPhonebookConsent_option_subtitle {
        font-size: var(--cpd-font-size-body-sm);
        color: var(--cpd-color-text-secondary);
    }

    .mx_SetPhonebookConsent_option_content {
        padding: 0 var(--option-padding) var(--option-padding);
        padding-left: calc(var(--option-padding) + var(--option-field-width) + var(--option-gap));
    }

    .mx_SetPhonebookConsent_option_bullets {
        margin: 0;
        padding-left: var(--cpd-space-5x);
        font-size: var(--cpd-font-size-body-sm);
        color: var(--cpd-color-text-secondary);

        li {
            margin-bottom: var(--cpd-space-1x);
        }
    }

    .mx_SetPhonebookConsent_option_warning {
        display: flex;
        align-items: flex-start;
        gap: var(--cpd-space-2x);
        margin-left: -3px;
        margin-top: var(--cpd-space-3x);
        font-size: var(--cpd-font-size-body-sm);
        font-weight: var(--cpd-font-weight-medium);
        color: var(--cpd-color-text-primary);
    }

    .mx_SetPhonebookConsent_option_warning_icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        color: var(--cpd-color-icon-quaternary);
    }

    .mx_SetPhonebookConsent_error {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        padding: var(--cpd-space-3x);
        border-radius: var(--cpd-space-2x);
        background-color: var(--cpd-color-bg-critical-subtle);
        font-size: var(--cpd-font-size-body-sm);
        color: var(--cpd-color-text-critical-primary);
    }

    .mx_SetPhonebookConsent_error_icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        color: var(--cpd-color-icon-critical-primary);
    }

    .mx_SetPhonebookConsent_disclaimer {
        margin-top: var(--cpd-space-4x);
        padding: var(--cpd-space-3x);
        font-size: var(--cpd-font-size-body-sm);
        color: var(--cpd-color-text-secondary);
        background-color: var(--cpd-color-bg-subtle-secondary);
        border-radius: var(--cpd-space-2x);
    }
}
