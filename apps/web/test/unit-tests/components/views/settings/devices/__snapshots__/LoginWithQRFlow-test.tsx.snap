exports[`<LoginWithQRFlow /> renders QR code 1`] = `
<div>
  <div
    class="mx_LoginWithQR"
    data-testid="login-with-qr"
  >
    <div
      class="mx_LoginWithQR_main"
    >
      <div
        class="mx_LoginWithQR_qrWrapper"
      >
        <div
          class="mx_QRCode mx_QRCode"
        >
          <img
            alt="QR Code"
            class="mx_VerificationQRCode"
            src="data:image/png;base64,"
          />
        </div>
      </div>
      <h1
        class="_typography_6v6n8_153 _font-heading-sm-semibold_6v6n8_93"
        style="margin-top: 32px; margin-bottom: 8px;"
      >
        Steps to log in
      </h1>
      <ol>
        <li>
          Open Beam on your phone
        </li>
        <li>
          Go to settings (press on your profile picture)
        </li>
        <li>
          <span>
            Select "
            <strong>
              Link a device
            </strong>
            "
          </span>
        </li>
        <li>
          Scan the QR code shown here
        </li>
        <li>
          Follow the remaining instructions
        </li>
      </ol>
      <div
        class="mx_LoginWithQR_mobileApps"
      >
        <p
          class="_typography_6v6n8_153 _font-body-sm-regular_6v6n8_31 mx_LoginWithQR_mobileApps_text"
        >
          Don't have the app yet? Download it here:
        </p>
        <div
          class="mx_LoginWithQR_mobileApps_badges"
        >
          <a
            href="https://beam.belgium.be"
            rel="noreferrer noopener"
            target="_blank"
          >
            <img
              alt="Download on the App Store"
              height="40"
              src="image-file-stub"
            />
          </a>
          <a
            href="https://beam.belgium.be"
            rel="noreferrer noopener"
            target="_blank"
          >
            <img
              alt="Get it on Google Play"
              height="40"
              src="image-file-stub"
            />
          </a>
        </div>
      </div>
    </div>
    <div
      class="mx_LoginWithQR_buttons"
    />
  </div>
</div>
`;

exports[`<LoginWithQRFlow /> renders check code confirmation 1`] = `
<div>
  <div
    class="mx_LoginWithQR"
    data-testid="login-with-qr"
  >
    <div
      class="mx_LoginWithQR_main"
    >
      <h1
        class="_typography_6v6n8_153 _font-heading-sm-semibold_6v6n8_93"
      >
        Enter the number shown on your other device
      </h1>
      <p
        class="_typography_6v6n8_153 _font-body-md-regular_6v6n8_50"
      >
        This will verify that the connection to your other device is secure.
      </p>
      <label
        for="mx_LoginWithQR_checkCode"
      >
        2-digit code
      </label>
      <div
        class="_container_1fye0_13 mx_LoginWithQR_checkCode_input mx_no_textinput"
      >
        <input
          autocomplete="one-time-code"
          class="_control_1fye0_28"
          id="mx_LoginWithQR_checkCode"
          inputmode="numeric"
          maxlength="2"
          minlength="0"
          pattern="\\d{2}"
          type="text"
        />
        <div
          aria-hidden="true"
          class="_digit_1fye0_52"
        />
        <div
          aria-hidden="true"
          class="_digit_1fye0_52"
        />
      </div>
      <div
        class="mx_ErrorMessage"
      />
    </div>
    <div
      class="mx_LoginWithQR_buttons"
    >
      <div
        class="mx_AccessibleButton mx_AccessibleButton_hasKind mx_AccessibleButton_kind_primary"
        data-testid="approve-login-button"
        role="button"
        tabindex="0"
      >
        Continue
      </div>
      <div
        class="mx_AccessibleButton mx_AccessibleButton_hasKind mx_AccessibleButton_kind_primary_outline"
        data-testid="decline-login-button"
        role="button"
        tabindex="0"
      >
        Cancel
      </div>
    </div>
  </div>
</div>
`;

