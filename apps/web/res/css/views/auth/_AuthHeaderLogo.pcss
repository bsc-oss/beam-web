.mx_AuthHeaderLogo {
    margin-top: 15px;
    flex: 1;
    padding: 0 25px;
}

.mx_AuthHeaderLogo img {
    width: 100%;
}

/* PG_CHANGED: Light mode: show light logo, hide dark logo */
.mx_AuthHeaderLogo_light {
    display: block;
}

.mx_AuthHeaderLogo_dark {
    display: none;
}

/* PG_CHANGED: Dark mode: show dark logo, hide light logo */
.cpd-theme-dark {
    .mx_AuthHeaderLogo_light {
        display: none;
    }

    .mx_AuthHeaderLogo_dark {
        display: block;
    }
}

@media only screen and (max-width: 480px) {
    .mx_AuthHeaderLogo {
        display: none;
    }
}
