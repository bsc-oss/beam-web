.mx_AuthHeader {
    display: flex;
    flex-direction: column;
    width: var(--mx-authpage-header-width); // PG_CHANGED: use re-usable var shared with server notice
    padding: 25px 25px;
    box-sizing: border-box;
}

@media only screen and (max-width: 480px) {
    .mx_AuthHeader {
        display: none;
    }
}
