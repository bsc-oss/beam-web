.mx_EmptyState {
    height: 100%;
    box-sizing: border-box;
    padding: var(--cpd-space-4x);
    text-align: center;

    svg {
        width: 56px;
        height: 56px;
        box-sizing: border-box;
        border-radius: 8px;
        padding: var(--cpd-space-3x);
        background-color: $panel-actions;
    }

    &::before {
        /* Bloom using magic numbers directly out of Figma */
        content: "";
        position: absolute;
        z-index: -1;
        width: 642px;
        height: 775px;
        right: -253.77px;
        top: 0;
        /* PG_CHANGED: yellow colour instead of green colour */
        background: radial-gradient(
            49.95% 49.95% at 50% 50%,
            rgba(218, 165, 104, 0.12) 0%,
            rgba(218, 165, 104, 0) 100%
        );
        transform: rotate(-89.69deg);
        overflow: hidden;
    }
}
