.mx_HomePage {
    display: grid;
    place-items: center;
    width: min(100% - 50px, 960px);
    height: 100%;
    margin: 0 auto;
    container-type: inline-size;
    container-name: homepage;
}

.mx_HomePage_default {
    text-align: center;

    img {
        height: 48px;
    }

    h1 {
        margin-bottom: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-32px;
        line-height: 1.375;
    }

    h2 {
        margin-top: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-18px;
        line-height: $font-25px;
        color: $muted-fg-color;
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
    }

    .mx_HomePage_default_buttons {
        /* PG_CHANGED: flex + center so 2 or 3 buttons stay centered
           (Explore button is hidden, leaving the fixed 3-col grid off-center) */
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px 40px;
        width: 100%;
        margin-top: 80px;
        margin-bottom: 20px;

        .mx_AccessibleButton {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 13px;
            box-sizing: border-box;
            width: 160px;
            min-height: 132px;
            padding: 8px 15px;
            border-radius: 8px;
            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-15px;
            line-height: $font-20px;
            /* PG_CHANGED */
            color: var(--cpd-color-text-secondary);
            background-color: var(--cpd-color-bg-subtle-tertiary);

            svg {
                display: block;
                width: 100%;
                height: 40px;
                object-fit: contain;
                color: $accent; /* on all themes */
            }
        }

        @container homepage (max-width: 559px) {
            flex-direction: column;

            .mx_AccessibleButton {
                flex-direction: row;
                width: 100%;
                min-height: 0;

                svg {
                    width: 24px;
                }
            }
        }
    }
}

/* PG_CHANGED */
.mx_HomePage_default .mx_HomePage_logo {
    margin: 0 auto;
    height: 96px;
}

.mx_HomePage_default .mx_HomePage_logo_light {
    display: block;
}

.mx_HomePage_default .mx_HomePage_logo_dark {
    display: none;
}

/* PG_CHANGED: Dark mode: show dark logo, hide light logo */
.cpd-theme-dark {
    .mx_HomePage_default .mx_HomePage_logo_light {
        display: none;
    }

    .mx_HomePage_default .mx_HomePage_logo_dark {
        display: block;
    }
}
